# =====================================================================
# flower-microservices-scaffolding 本地敏感配置模板（仓库根）
# @Author: 花海
# @Date: 2026/08/16
# @Description: 复制本文件为仓库根 .env 后填写（.env 已被 .gitignore 忽略，不会提交仓库）。
#               框架启动时自动加载 cwd 的 .env；各服务 application.yml 中 ${ENV} / ${ENV:default}
#               占位符与环境变量覆盖均可读取此处值；已存在的进程/容器环境变量优先（.env 不覆盖）。
#               服务启动 / Alembic 迁移命令均在仓库根目录执行（见 docs/使用说明.md）。
#               组件配置段由脚手架组件选择生成：未选择/关闭的组件整块移除；
#               注册中心强制 Nacos（禁止内存实现）。
# =====================================================================

# <<<COMPONENT:db>>>
# =====================================================================
# MySQL（docker-compose 默认 root/root；服务分库：user-service -> flower_user / order-service -> flower_order）
# =====================================================================
APP_DB_MYSQL_HOST=127.0.0.1
APP_DB_MYSQL_PORT=3306
APP_DB_MYSQL_USERNAME=root
APP_DB_MYSQL_PASSWORD=root
APP_DB_USER_MYSQL_DATABASE=flower_user
APP_DB_ORDER_MYSQL_DATABASE=flower_order
# <<</COMPONENT:db>>>

# <<<COMPONENT:cache>>>
# =====================================================================
# Redis（docker-compose 提供；app.cache.type=redis 时填写）
# =====================================================================
APP_CACHE_REDIS_HOST=127.0.0.1
APP_CACHE_REDIS_PORT=6379
APP_CACHE_REDIS_DB=0
APP_CACHE_REDIS_PASSWORD=
APP_CACHE_REDIS_USERNAME=
# <<</COMPONENT:cache>>>

# <<<COMPONENT:storage>>>
# =====================================================================
# MinIO 对象存储（application.yml 中 storage.type=minio 时填写；local 无需配置）
# =====================================================================
APP_STORAGE_MINIO_ENDPOINT=localhost:9000
APP_STORAGE_MINIO_ACCESS_KEY=
APP_STORAGE_MINIO_SECRET_KEY=
# <<</COMPONENT:storage>>>

# <<<COMPONENT:mq>>>
# =====================================================================
# RocketMQ（application.yml 中 mq.type=rocketmq 时填写；memory 无需配置）
# =====================================================================
APP_MQ_ROCKETMQ_NAMESERVER=127.0.0.1:9876
# <<</COMPONENT:mq>>>

# <<<COMPONENT:registry>>>
# =====================================================================
# Nacos 注册中心（docker-compose 提供；三个服务均注册到 Nacos，强制启用、禁止内存实现）
# 注册对外 IP（生产容器必须显式注入，否则回退网关/UDP 探测可能拿到容器内网 IP）：
# 通用变量 NACOS_REGISTER_IP / K8s 自动注入 POD_IP / Docker 宿主机 HOST_IP
# NACOS_REGISTER_IP=1.2.3.4
# =====================================================================
APP_REGISTRY_NACOS_SERVER=127.0.0.1:8848
APP_REGISTRY_NACOS_NAMESPACE=public
APP_REGISTRY_NACOS_GROUP=DEFAULT_GROUP
# <<</COMPONENT:registry>>>

# <<<COMPONENT:config>>>
# =====================================================================
# Nacos 配置中心（config 组件启用时填写，复用 registry.nacos 客户端）
# =====================================================================
APP_CONFIG_NACOS_DATA_ID=
# <<</COMPONENT:config>>>

# <<<COMPONENT:mongo>>>
# =====================================================================
# MongoDB（mongo 组件启用时填写，需安装 mongo extras）
# =====================================================================
APP_MONGO_URL=mongodb://localhost:27017
APP_MONGO_DATABASE=app
APP_MONGO_USERNAME=
APP_MONGO_PASSWORD=
# <<</COMPONENT:mongo>>>

# <<<COMPONENT:jwt>>>
# =====================================================================
# 统一鉴权签发密钥（启用 auth 中间件 / JWT SPI 示例签发时必填；
# EnvJwtKeyProvider 从本变量派生 access/refresh 两段密钥）
# =====================================================================
JWT_SECRET_KEY=
# <<</COMPONENT:jwt>>>

# <<<COMPONENT:payment>>>
# =====================================================================
# 微信支付渠道配置（order-service 支付示例切换 app.payment.type=wechat 时填写；
# 默认 memory 内存渠道无需配置）
# =====================================================================
APP_PAYMENT_WECHAT_APPID=
APP_PAYMENT_WECHAT_MCHID=
APP_PAYMENT_WECHAT_MCH_SERIAL_NO=
APP_PAYMENT_WECHAT_API_V3_KEY=
APP_PAYMENT_WECHAT_PRIVATE_KEY=
APP_PAYMENT_WECHAT_PRIVATE_KEY_PATH=
APP_PAYMENT_WECHAT_NOTIFY_URL=
APP_PAYMENT_WECHAT_REFUND_NOTIFY_URL=
APP_PAYMENT_WECHAT_PUBLIC_KEY_ID=
APP_PAYMENT_WECHAT_PUBLIC_KEY=
# <<</COMPONENT:payment>>>

# =====================================================================
# 框架通用配置（所有服务共享；敏感项经环境变量注入，禁止落盘）
# =====================================================================
# 应用环境标识（规范 §19.3）：dev / test / stage / prod；生产环境必须显式指定 APP_ENV=prod
APP_ENV=dev
# 应用时区（规范 §16.1 全链路 UTC 存储）：默认 UTC；业务时区可覆盖，如 Asia/Shanghai
APP_TIMEZONE=UTC
# 敏感配置加密密钥（规范 §15.2）：enc: 前缀加密配置值（ConfigCipher / SecureConfigLoader）的
# Fernet 对称密钥，通过环境变量注入禁止落盘。生成示例（cryptography 为框架核心依赖）：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONFIG_ENCRYPT_KEY=
# JWT 过期时间（分钟，SecureConfigLoader 读取，默认 120）
JWT_EXPIRE_MINUTES=120
# 本地对象存储签名 URL 密钥（storage.type=local 时私有文件签名 URL 的 HMAC 密钥；
# 默认值仅用于开发/测试，生产必须经环境变量注入）
LOCAL_STORAGE_PRESIGN_SECRET=local-presign-secret
# tokenizer 资源根目录（AI Token 精确计数，留空回退字符估算）
LLM_MODEL_RESOURCE_DIR=

# =====================================================================
# 各服务 Alembic 迁移数据库 URL（alembic/env.py 自动加载 .env 读取；
# 优先级：服务专属变量 USER_DATABASE_URL / ORDER_DATABASE_URL > 通用 DATABASE_URL > alembic.ini）
# =====================================================================
USER_DATABASE_URL=mysql+aiomysql://root:root@127.0.0.1:3306/flower_user
ORDER_DATABASE_URL=mysql+aiomysql://root:root@127.0.0.1:3306/flower_order
DATABASE_URL=

# AI 模型 API Key（框架 model_config 支持 env:VAR 引用，如 api_key: "env:LLM_API_KEY"）
LLM_API_KEY=

# 雪花 ID 工作节点（多实例部署必须为每个实例配置唯一 worker_id，否则同一毫秒内不同实例可能生成重复 ID）
SNOWFLAKE_WORKER_ID=0
